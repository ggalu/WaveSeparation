# Everything a script writes goes into the case folder it was run on, so the
# generated files all live under cases/. What is TRACKED there is each case's
# case.toml and its measured record (*.txt) -- the inputs -- plus the
# figures README.md refers to or embeds. Everything else in a case folder is
# reproducible from those with simulate.py / identify_bar_*.py / the analysis
# scripts, and is the same set ./clean.sh removes.

__pycache__/
*.pyc

cases/**/*
!cases/**/
!cases/**/case.toml
!cases/**/*.txt
!cases/simulations/*/specimen_reconstruction.png
!cases/simulations/*/gauge_forces.png
!cases/analyses/pc_specimen/gauges_at_interface.png

# superseded output formats, in case an older revision is run here
dump.npz
bar_identified.npz
eps.npy
force.npy
meta.npz
meta.npy
